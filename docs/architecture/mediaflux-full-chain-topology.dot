  pending [label="待确认案例与文件快照\norganize_confirmations.py\n证据不足保留原位；本地单项确认", color="#7C3AED", fillcolor="#F5F3FF", pos="360,1400!", pin=true];
  review [label="可选 Agent 只读复核\nagent_recognition_review.py\n单组按既有授权；光鸭多组只给建议", color="#B45309", fillcolor="#FFFBEB", pos="0,1400!", pin=true];
  confirm [label="确认认领与复验\nWeb / TG / SDK；光鸭跨页批次审阅\n冻结候选与建议，改选使旧预览失效", color="#7C3AED", fillcolor="#F5F3FF", pos="360,1260!", pin=true];
  local [label="本地执行器 / 移动事务\nlocal_media_service / local_move_transaction\nWriter 锁、目标复验、移动、失败补偿", color="#2563EB", fillcolor="#EFF6FF", pos="360,1120!", pin=true];
  cloud [label="光鸭执行器 / 逐项回读\norganize_tasks / organize_execution\nmkdir / move / rename，未知结果不盲重放", color="#0F766E", fillcolor="#F0FDFA", pos="1080,1120!", pin=true];
  local_finish [label="本地归档与下载收尾\n提交媒体 / 字幕，移除 qB 不删文件\n清理明确垃圾与空目录，保留未知文件", color="#2563EB", fillcolor="#EFF6FF", pos="360,980!", pin=true];
  cloud_finish [label="云端后处理与暂存收尾\norganize_postprocess.py\n按开关回收同版本落选文件，核验空父链到 MF 根", color="#0F766E", fillcolor="#F0FDFA", pos="1080,980!", pin=true];
  strm [label="STRM 增量同步 / 完整校准\nstrm.py / scheduler.py\n来源 ID 固定本地层级；完整扫描才判缺失", color="#15803D", fillcolor="#F0FDF4", pos="1080,840!", pin=true];
  files [label="本地媒体 / STRM 文件\n媒体库目录 / STRM_ROOT\n.strm、NFO、图片、字幕，供媒体库读取", color="#64748B", fillcolor="#F1F5F9", pos="360,700!", pin=true];
  refresh [label="持久刷新交接与路径映射\nmedia_refresh_coordinator / media_refresh\n合并、租约、去重；MF → 媒体库路径\n电影自身 / 剧集优先整剧；失败告警结束", color="#15803D", fillcolor="#F0FDF4", pos="720,700!", pin=true];
  sidecar [label="伴随元数据队列\nstrm_metadata_worker.py\nNFO / 图片独立排队；刷新不等待队列清空", color="#15803D", fillcolor="#F0FDF4", pos="1080,700!", pin=true];
  server [label="Jellyfin / Emby 媒体库\n扫描、补缺元数据与图片，更新剧集汇总日期\nPlaybackInfo / 上游直放、HLS / 转码", color="#64748B", fillcolor="#F1F5F9", pos="720,560!", pin=true];
  proxy [label="MF 媒体反代 / 播放协商\nmedia_proxy.py · HTTP / WS / PlaybackInfo\n按客户端与媒体源选择直连、转发或上游", color="#0891B2", fillcolor="#ECFEFF", pos="360,420!", pin=true];
  quality [label="签名播放入口 / 云盘画质\n/playgy · playgy_signing.py\n普通 GET → 302；variants / resolve → JSON", color="#0891B2", fillcolor="#ECFEFF", pos="720,280!", pin=true];
  cdn [label="光鸭 CDN\n短时视频地址 · 原画 / 可用云端画质\n实际视频数据由这里传出", color="#64748B", fillcolor="#F1F5F9", pos="1080,140!", pin=true];
