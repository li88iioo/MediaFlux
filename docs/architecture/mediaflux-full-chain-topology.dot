// 固定业务层次与节点坐标；使用 neato -n2 -Tsvg 重建，勿用 dot 自动重排。
// 节点表示业务职责；跨区连接保留实际调用、状态交接与视频流向。
digraph MediaFluxFullChain {
  graph [splines=ortho, overlap=true, bgcolor="#F8FAFC", fontname="Noto Sans CJK SC", fontsize=20, fontcolor="#0F172A", labelloc=t, labeljust=l, pad=0.35, nodesep=0.32, ranksep=0.9, label=<<TABLE BORDER="0" CELLBORDER="0" WIDTH="1600"><TR><TD ALIGN="LEFT">MediaFlux · 业务全链路拓扑</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">实线：调用 / 数据　虚线：异步 / 调度　点线：持久化 / 恢复　绿色粗线：CDN 视频直达播放器</FONT></TD></TR></TABLE>>];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK SC", fontsize=11, fontcolor="#0F172A", width=4.0, height=0.95, margin="0.16,0.12", penwidth=1.1];
  edge [fontname="Noto Sans CJK SC", fontsize=9, arrowsize=0.7, penwidth=1.2];
  boot [label="容器 / CLI 启动\nmediaflux.py → app/cli.py\n配置、路径、权限与进程锁", color="#64748B", fillcolor="#F1F5F9", pos="0,2380!", pin=true];
  app [label="FastAPI 生命周期\napp/main.py · create_app / lifespan\n路由、中间件、/healthz、/readyz", color="#64748B", fillcolor="#F1F5F9", pos="360,2380!", pin=true];
  schedule [label="后台调度与任务恢复\nRSS / 下载跟踪 / 整理 / STRM / 刷新\n启动恢复、任务租约、单进程单 Worker", color="#64748B", fillcolor="#F1F5F9", pos="720,2380!", pin=true];
  web [label="Web 控制台 / API\nJinja2 + static + app/routes/*\nSession / CSRF · JSON / NDJSON / SSE\n提交资源、手动整理 / 纠正、同步", color="#2563EB", fillcolor="#EFF6FF", pos="0,2240!", pin=true];
  tg [label="Telegram 用户 / Bot\nbot/handlers.py / progress.py\n命令、磁力、种子、自然语言、确认回调\n/sync_gy 同步 · 通知卡片更新", color="#2563EB", fillcolor="#EFF6FF", pos="360,2240!", pin=true];
  discovery [label="发现、订阅与资源筛选\ndiscovery / indexers / rss.py\n季集、排期、排除词、库内检查", color="#EA580C", fillcolor="#FFF7ED", pos="720,2240!", pin=true];
  sources [label="RSS / 蜜柑 / 多站资源\nTMDB · 豆瓣 · Bangumi\n订阅、搜索、榜单与外部资料", color="#64748B", fillcolor="#F1F5F9", pos="1080,2240!", pin=true];
