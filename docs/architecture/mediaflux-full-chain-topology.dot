  sdk [label="agent.run_code → SDK RPC\nBubblewrap + seccomp · /work /skills /output\n真实签名生成帮助；未登记方法拒绝", color="#B45309", fillcolor="#FFFBEB", pos="0,1960!", pin=true];
  effects [label="写入预检、冻结与执行\nEffectExecutor / sdk_effects.py\n按合同确认，仅执行冻结计划并留回执", color="#B45309", fillcolor="#FFFBEB", pos="0,1820!", pin=true];
  dispatch [label="统一下载请求与目标分发\ndownload_dispatcher.py\n协议识别、幂等、目标独立状态、补投", color="#EA580C", fillcolor="#FFF7ED", pos="720,2100!", pin=true];
  qb [label="qBittorrent\n磁力 / 种子 / HTTP\n保留 RSS、Telegram 各自默认分类", color="#64748B", fillcolor="#F1F5F9", pos="360,1960!", pin=true];
  offline [label="光鸭离线 / 分享转存\n目标目录、文件树筛选\n任务已受理后继续跟踪完成状态", color="#64748B", fillcolor="#F1F5F9", pos="1080,1960!", pin=true];
  tracker [label="下载完成跟踪\ndownload_tracker.py\n回读任务与文件，真实完成才交接整理", color="#EA580C", fillcolor="#FFF7ED", pos="720,1820!", pin=true];
  scan [label="本地 / 云端任务扫描\n各自任务入口，共享文件上下文\n文件、父目录、媒体规格与来源快照", color="#7C3AED", fillcolor="#F5F3FF", pos="720,1680!", pin=true];
  recognize [label="统一识别、规则与版本计划\nrecognition / scraper / naming\n标题、年份、季集、候选复核、命名与冲突", color="#7C3AED", fillcolor="#F5F3FF", pos="720,1540!", pin=true];
