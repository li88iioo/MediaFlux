# MediaFlux Docker 开发环境
#
# 首次使用：
#   cp .env.development.example .env.development
#   docker compose --env-file .env.development -f docker-compose.dev.yml up -d --build
#
# 这里只保留构建、端口、运行模式和挂载路径。
# Telegram、下载器、媒体服务器、索引站等业务配置统一在 Web 页面维护。

# ---------- 镜像与构建信息 ----------
# 本地开发镜像名称。
MEDIAFLUX_DEV_IMAGE=mediaflux:dev
# 写入镜像构建信息；开发构建保持默认即可。
VERSION_REF=v0.0.0-dev
GIT_SHA=development
# 可选 amd64 或 arm64，应与构建机器架构一致。
TARGETARCH=amd64

# ---------- 宿主机端口 ----------
# MediaFlux Web：宿主机端口 -> 容器固定端口 1258。
MEDIAFLUX_PUBLISH_PORT=1258
# 开发用媒体反代：宿主机端口 -> 容器实例端口 18096。
# 如在页面把实例监听端口改为其他值，还需同步修改 docker-compose.dev.yml 右侧端口。
MEDIA_PROXY_PORT=18096

# ---------- 容器运行模式 ----------
# 覆盖正式镜像内置的 production，启用开发环境行为；不要用于生产部署。
APP_ENV=development
# bridge 网络下必须监听全部容器接口，宿主机端口映射才能访问。
WEB_HOST=0.0.0.0
# 默认关闭框架调试器；确有需要时改为 1。
WEB_DEBUG=0
# Web 目录选择器允许浏览的容器内根目录。
LOCAL_MEDIA_BROWSE_ROOTS=/media/downloads,/media/library

# ---------- 宿主机挂载目录 ----------
# 路径相对于仓库根目录，也可以改成绝对路径。
MEDIAFLUX_DATA_HOST_PATH=./db
STRM_HOST_PATH=./strm-data
MEDIA_DOWNLOADS_HOST_PATH=./media-downloads
MEDIA_LIBRARY_HOST_PATH=./media-library

# ---------- 可选：以指定 UID/GID 运行 ----------
# 默认保持 NAS 兼容模式，无需配置。需要验证非 root 场景时取消注释：
# MEDIAFLUX_RUN_AS_ROOT=0
# PUID=10001
# PGID=10001
# UMASK=022
# 大型 STRM 目录通常不要开启递归修权；仅测试需要时设为 1。
# MEDIAFLUX_FIX_STRM_PERMISSIONS=0
