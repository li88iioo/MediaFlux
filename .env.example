# MediaFlux Docker Compose deployment template
# 该文件只控制容器启动、宿主机端口/挂载与首个管理员凭据。
# Telegram、下载器、探索、Agent、整理规则等业务配置请在 Web「设置」页维护；
# 页面保存内容位于 ./db/user.env，不会被本 Compose 文件静默覆盖。

# 必填：生成 Secret：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空时 Compose 会拒绝启动。
WEB_SECRET_KEY=
MEDIAFLUX_INITIALIZED=1
ENV_WEB_PASSPORT=
ENV_WEB_PASSWORD=

# Docker 默认仅发布到宿主机回环地址；局域网访问时显式改为 0.0.0.0。
# MEDIAFLUX_PUBLISH_HOST 只控制宿主机发布地址，容器内 WEB_HOST 固定为 0.0.0.0。
# WEB_HOST=0.0.0.0（由 docker-compose.yml 固定注入，不在此处配置）
MEDIAFLUX_PUBLISH_HOST=127.0.0.1
# WEB_PORT 只控制宿主机发布端口；容器内部固定监听 0.0.0.0:1258。
# Docker 模式下网络发布由 Compose 管理，不要再从 Web 设置页修改。
WEB_PORT=1258
MEDIAFLUX_IMAGE=ghcr.io/li88iioo/mediaflux:latest

# HTTP 访问保持 0；经 HTTPS 反向代理访问时必须设为 1。
SESSION_COOKIE_SECURE=0

# 可选：Prometheus 无会话抓取 /api/agent/metrics 时使用；至少 24 位且不得复用其他密钥。
# AGENT_METRICS_SCRAPE_KEY=

# 持久化与媒体目录。容器以 UID/GID 10001 运行，请提前授予访问权限。
STRM_HOST_PATH=./strm-data
MEDIA_DOWNLOADS_HOST_PATH=./media-downloads
MEDIA_LIBRARY_HOST_PATH=./media-library
# 目录选择器只能浏览容器内路径；多个根目录可用逗号、分号或换行分隔。
LOCAL_MEDIA_BROWSE_ROOTS=/media/downloads,/media/library

# 镜像内固定运行目录（仅说明，不要取消注释后覆盖）：
# MEDIAFLUX_DATA_DIR=/app/db
# MEDIAFLUX_CONFIG_DIR=/app/db
# MEDIAFLUX_CACHE_DIR=/app/db/cache
# MEDIAFLUX_LOG_DIR=/app/db/logs
# MEDIAFLUX_STRM_DIR=/data/strm
