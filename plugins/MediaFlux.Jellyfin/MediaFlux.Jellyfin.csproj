<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.3</Version>
    <AssemblyName>MediaFlux.Jellyfin</AssemblyName>
    <RootNamespace>MediaFlux.Jellyfin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <EmbeddedResource Include="Configuration/configPage.html" />
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
